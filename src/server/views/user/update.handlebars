<h3>Atualizar Usuário</h3>
<div class="container">
<form id="updateForm" class="form-container">
  <label for="name">Nome:</label>
  <input type="text" id="name" name="name" value="{{user.name}}" required />

  <label for="email">Email:</label>
  <input type="email" id="email" name="email" value="{{user.email}}" required />

  <button type="submit" class="btn-submit">Atualizar</button>
  <button class="btn-back">
    <a href="/user/list" style="text-decoration: none; color: white;">Voltar</a>
  </button>
</form>
</div>

<script>
  document.getElementById('updateForm').addEventListener('submit', async function(event) {
    event.preventDefault(); // Evita o envio padrão do formulário

    const userId = "{{user.id}}"; // Obtém o ID do usuário
    const formData = {
      name: document.getElementById('name').value,
      email: document.getElementById('email').value
    };

    const response = await fetch('/user/update/' + userId, {
      method: 'PUT', // Envia a requisição como PUT
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(formData)
    });

    if (response.ok) {
      alert('Usuário atualizado com sucesso!');
      window.location.href = '/user/list'; // Redireciona para a lista de usuários
    } else {
      alert('Erro ao atualizar usuário.');
    }
  });
</script>


