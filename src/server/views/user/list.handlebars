<div class="container">
  <div class="box">
    <div class="header">
      <h2>Lista de Usuários</h2>
      <a href="/user/create/page" class="btn-create">Cadastrar Novo Usuário</a>
    </div>

    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Nome</th>
          <th>Email</th>
          <th>Password</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        {{#each users}}

          <tr>
            <td>{{this.id}}</td>
            <td>{{this.name}}</td>
            <td>{{this.email}}</td>
            <td>{{this.password}}</td>
            <td>
              <a href="/user/update/{{this.id}}" class="btn-edit">Editar</a>
              <button
                type="button"
                class="btn-delete"
                onclick="confirmDelete({{this.id}})"
              >Deletar</button>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</div>

<style>
  .container { display: flex; flex-direction: column; align-items: center;
  justify-content: center; margin-top: 20px; } .box { background-color: white;
  padding: 20px; border-radius: 8px; width: 80%; box-shadow: 0 4px 8px rgba(0,
  0, 0, 0.1); } .header { display: flex; justify-content: space-between;
  align-items: center; } h2 { margin: 0; } /* Estilos para a tabela */ table {
  width: 100%; border-collapse: collapse; margin-top: 20px; } th, td { padding:
  12px; text-align: left; border-bottom: 1px solid #ddd; } th {
  background-color: #f4f4f4; font-weight: bold; } tr:nth-child(even) {
  background-color: #f9f9f9; } tr:hover { background-color: #f1f1f1; } /* Estilo
  dos botões */ .btn-edit, .btn-delete, .btn-create { display: inline-block;
  padding: 8px 16px; text-decoration: none; color: white; font-weight: bold;
  border-radius: 5px; text-align: center; transition: background-color 0.3s,
  color 0.3s; margin-right: 10px; } /* Cor para o botão Editar */ .btn-edit {
  background-color: #007bff; border: none; padding: 8px; padding-left: 15px;
  padding-right: 15px; } .btn-edit:hover { background-color: #0056b3; } /* Cor
  para o botão Deletar */ .btn-delete { background-color: #dc3545; border: none;
  font-size: 1rem; } .btn-delete:hover { background-color: #c82333; } /* Cor
  para o botão Cadastrar */ .btn-create { background-color: #28a745; display:
  inline-block; border: none; margin-left: 0; } .btn-create:hover {
  background-color: #218838; } /* Responsividade para telas maiores */ @media
  (max-width: 1024px) { table { font-size: 14px; } th, td { padding: 10px; }
  .btn-edit, .btn-delete, .btn-create { font-size: 14px; padding: 6px 12px; } }
  @media (max-width: 768px) { table { font-size: 12px; } th, td { padding: 8px;
  } .btn-edit, .btn-delete, .btn-create { font-size: 13px; padding: 6px 12px; }
  } @media (max-width: 480px) { table { font-size: 12px; } th, td { padding:
  6px; } .btn-edit, .btn-delete, .btn-create { font-size: 12px; padding: 5px
  10px; margin-right: 5px; } } @media (max-width: 320px) { .box { width: 100%;
  padding: 10px; } table { font-size: 10px; } th, td { padding: 4px; }
  .btn-edit, .btn-delete, .btn-create { font-size: 10px; padding: 4px 8px; } }
</style>

<script>
  function confirmDelete(userId) { if (confirm('Tem certeza que deseja excluir
  este usuário?')) { fetch('/user/delete/' + userId, { method: 'DELETE', //
  Método POST para deletar headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ id: userId }) // Enviar o ID do usuário no corpo da
  requisição }) .then(response => { if (response.ok) { alert('Usuário deletado
  com sucesso!'); window.location.reload(); // Recarregar a página para
  atualizar a lista } else { alert('Erro ao deletar usuário.'); } })
  .catch(error => console.error('Erro:', error)); } }

</script>