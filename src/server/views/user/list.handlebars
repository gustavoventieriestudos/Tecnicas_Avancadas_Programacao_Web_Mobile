<div class="container mt-5">
  <div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h2 class="mb-0">Lista de Usuários</h2>
      <a href="/user/create/page" class="btn btn-success">Cadastrar Novo Usuário</a>
    </div>
    <div class="card-body">
      <table class="table table-bordered table-striped">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nome</th>
            <th>Email</th>
            <th>Password</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          {{#each users}}
          <tr>
            <td>{{this.id}}</td>
            <td>{{this.name}}</td>
            <td>{{this.email}}</td>
            <td>{{this.password}}</td>
            <td>
              <a href="/user/update/{{this.id}}" class="btn btn-primary btn-sm">Editar</a>
              <button type="button" class="btn btn-danger btn-sm" onclick="confirmDelete({{this.id}})">Deletar</button>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Responsividade e estilos personalizados do Bootstrap -->
<style>
  /* Ajuste de espaçamento para o botão de deletar e editar */
  .btn-sm {
    padding: 0.3rem 0.6rem;
  }

  /* Tamanho da tabela em dispositivos menores */
  @media (max-width: 768px) {
    table {
      font-size: 12px;
    }

    .btn {
      font-size: 14px;
      padding: 6px 12px;
    }
  }

  /* Estilos para telas muito pequenas */
  @media (max-width: 480px) {
    table {
      font-size: 10px;
    }

    .btn {
      font-size: 12px;
      padding: 5px 10px;
    }
  }
</style>

<script>
  function confirmDelete(userId) {
    if (confirm('Tem certeza que deseja excluir este usuário?')) {
      fetch('/user/delete/' + userId, {
        method: 'DELETE', // Método DELETE para deletar
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: userId }) // Enviar o ID do usuário no corpo da requisição
      })
        .then(response => {
          if (response.ok) {
            alert('Usuário deletado com sucesso!');
            window.location.reload(); // Recarregar a página para atualizar a lista
          } else {
            alert('Erro ao deletar usuário.');
          }
        })
        .catch(error => console.error('Erro:', error));
    }
  }
</script>